PORT=4310

JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_SECRET=
# Emails separados por coma — cualquiera de esas cuentas entra con rol
# "superadmin" (panel /superadmin), sin importar si están guardadas como
# admin o player. Ver src/core/constants/roles.ts.
SUPERADMIN_EMAILS=

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PG_POOL_MAX=40

# Emails (código para recuperar la contraseña) — https://resend.com
# Sin RESEND_API_KEY el server levanta igual, pero no envía los códigos.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend
MAIL_FROM=MyTTM <no-reply@myttm.cl>

# Versión de la app del jugador (GET /api/v1/app/version)
# Build mínimo aceptado: las versiones más viejas ven "Actualiza MyTTM" y no pueden seguir
APP_MIN_BUILD=0
# Último build publicado: las versiones más viejas ven una sugerencia de actualizar
APP_LATEST_BUILD=0
# Dónde se actualiza (Play Store, o la descarga del APK mientras no esté en la tienda)
APP_UPDATE_URL=https://play.google.com/store/apps/details?id=cl.myttm.app

PORT=4310

JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_SECRET=
# Emails separados por coma — cualquiera de esas cuentas entra con rol
# "superadmin" (panel /superadmin), sin importar si están guardadas como
# admin o player. Ver src/core/constants/roles.ts.
SUPERADMIN_EMAILS=

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PG_POOL_MAX=40

# Emails (código para recuperar la contraseña) — https://resend.com
# Sin RESEND_API_KEY el server levanta igual, pero no envía los códigos.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend
MAIL_FROM=MyTTM <no-reply@myttm.cl>
